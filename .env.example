# ── Port ─────────────────────────────────────────────────────────
# Sur Pterodactyl, utilise la variable d'environnement "PORT" ou
# "SERVER_PORT" configurée par ton egg (panneau Startup). Doit
# correspondre au port alloué/ouvert pour le serveur.
PORT=10000

# ── Dossier des sessions WhatsApp ───────────────────────────────
# Sur Pterodactyl, le disque du serveur est persistant par défaut :
# tu n'as RIEN à faire, le dossier ./sessions du projet suffit et
# survit aux redémarrages. Ne décommente SESSION_DIR que si tu veux
# un chemin différent.
# SESSION_DIR=./sessions

# ── Ton numéro WhatsApp propriétaire (sans le +) ────────────────
OWNER_NUMBER=243802506198

# ── Optionnel : Préfixe des commandes (défaut : .) ──────────────
# PREFIX=.

# ── Optionnel : Nom du bot ───────────────────────────────────────
# BOT_NAME=NEXO-JARVIS XMD

# ── Session Manager / workers ───────────────────────────────────
WORKER_ID=worker-1
MAX_WORKERS=1
WORKER_MAX_SESSIONS=100
STORAGE=local
# SESSION_REGISTRY_FILE=./sessions/registry.json
# REDIS_URL=
# DATABASE_URL=
# ADMIN_TOKEN=change-me
# MAX_RECONNECT_ATTEMPTS=10

# ── Optionnel : API du chatbot ───────────────────────────────────
# CHATBOT_API_URL=https://zellapi.autos/ai/chatbot
# CHATBOT_API_KEY=
# OPENAI_API_KEY=
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-4o-mini

# ── Optionnel : APIs de téléchargement/médias ───────────────────
# XTEAM_API_KEY=
# LOLHUMAN_API_KEY=
# NEOXR_API_KEY=
# ZENZ_API_KEY=
# FGMODS_API_KEY=

# ── Requis uniquement pour .tg / .stickertelegram ───────────────
# TELEGRAM_BOT_TOKEN=123456:replace_with_your_token

# ── Chaîne WhatsApp & aperçus ──
# Le JID de la chaîne (bouton « Voir la chaîne ») est résolu automatiquement à la connexion.
# Facultatif : le forcer à la main (format 120363...@newsletter).
# CHANNEL_JID=
# Aperçus d'images : déposer des .jpg/.png dans jarvis-images/ (ou choisir un autre dossier) :
# PREVIEW_IMAGES_DIR=
# Clé Giphy pour la commande .gif (gratuite sur developers.giphy.com) :
# GIPHY_API_KEY=

# ── Intelligence artificielle (.gpt, .gemini, chatbot) ──────────────────────
# Une clé GRATUITE rend l'IA fiable. Sans clé, des API publiques sont essayées
# une à une (elles peuvent tomber à tout moment).
# GEMINI_API_KEY=      # https://aistudio.google.com/apikey  (gratuit)
# GROQ_API_KEY=        # https://console.groq.com/keys       (gratuit)
# POLLINATIONS_API_KEY=  # texte et images

# ── Téléchargements (.song / .play / .video) ──
# yt-dlp est téléchargé automatiquement (dossier bin/). YouTube bloque beaucoup d'adresses d'hébergeurs (Railway…) : si .dltest
# affiche « YouTube bloque cette adresse », fournissez les cookies d'un compte YouTube (format Netscape, extension « Get cookies.txt LOCALLY »),
# soit en texte (YT_COOKIES), soit encodés en base64 (YT_COOKIES_B64 : plus pratique dans Railway).
# YT_COOKIES_B64=
# YT_DLP_AUTOINSTALL=0   # pour désactiver le téléchargement automatique de yt-dlp
